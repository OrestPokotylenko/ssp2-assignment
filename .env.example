# Docker Compose host ports
API_PORT=8080
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# RabbitMQ credentials used by all containers
RABBITMQ_USER=southpark
RABBITMQ_PASSWORD=southpark
RABBITMQ_QUEUE=southpark_messages

# Consumer behavior
RABBITMQ_RETRY_SECONDS=2

# Automatic message generator behavior
GENERATOR_INTERVAL_SECONDS=5
GENERATOR_HTTP_TIMEOUT_SECONDS=5

# Logging (consumer defaults keep the dedicated message console clean)
CONSUMER_LOG_LEVEL=ERROR
PIKA_LOG_LEVEL=CRITICAL
GENERATOR_LOG_LEVEL=INFO
